{
  "expo": {
    "name": "Home Cockpit",
    "slug": "home-cockpit",
    "scheme": "homecockpit",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": { "package": "com.larrabee.homecockpit" },
    "ios": {
      "bundleIdentifier": "com.larrabee.homecockpit",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to your Home Assistant on the home network.",
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true }
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-build-properties", { "android": { "usesCleartextTraffic": true } }]
    ],
    "experiments": { "typedRoutes": true }
  }
}
