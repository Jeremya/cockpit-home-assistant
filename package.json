{
  "name": "home-cockpit",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "house:prepare": "node --import tsx scripts/prepare-house-plan.ts",
    "postinstall": "patch-package --error-on-fail && npm run house:prepare",
    "prestart": "npm run house:prepare",
    "preweb": "npm run house:prepare",
    "preandroid": "npm run house:prepare",
    "preexport:android": "npm run house:prepare",
    "pretypecheck": "npm run house:prepare",
    "pretest": "npm run house:prepare",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "lint": "expo lint",
    "export:android": "expo export --platform android",
    "proof:protocol": "tsx scripts/prove-protocol.ts",
    "proof:ha": "tsx scripts/prove-ha.ts",
    "format:check": "prettier --check app src scripts plugins app.config.js app.json package.json tsconfig.json eslint.config.js jest.config.js compose.yaml",
    "ha:up": "node scripts/setup-ha.mjs && docker compose up -d",
    "ha:logs": "docker compose logs --tail=100 homeassistant",
    "proof:dependencies": "tsx scripts/prove-dependencies.ts",
    "build:trial:android": "node scripts/build-trial-android.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.30",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-router": "57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "home-assistant-js-websocket": "9.7.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "three": "0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "@types/three": "0.186.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "patch-package": "8.0.1",
    "prettier": "^3.9.10",
    "react-test-renderer": "^19.2.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "ws": "^8.22.0"
  },
  "overrides": {
    "query-string@7.1.3": {
      "decode-uri-component": "0.5.0"
    }
  }
}
